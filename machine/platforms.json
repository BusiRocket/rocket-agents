{
  "version": 1,
  "platforms": [
    {
      "registryId": "amp",
      "capabilities": ["skills"],
      "probe": { "configPaths": ["$HOME/.config/amp"] }
    },
    {
      "registryId": "cursor",
      "capabilities": ["skills", "rules", "mcp"],
      "probe": {
        "commands": ["cursor-agent"],
        "appPaths": ["/Applications/Cursor.app"],
        "configPaths": ["$HOME/.cursor"]
      }
    },
    {
      "registryId": "claude",
      "capabilities": [
        "skills",
        "rules",
        "hooks",
        "plugins",
        "mcp",
        "security"
      ],
      "probe": { "commands": ["claude"], "configPaths": ["$HOME/.claude"] }
    },
    {
      "registryId": "codex",
      "capabilities": [
        "skills",
        "rules",
        "hooks",
        "plugins",
        "mcp",
        "security"
      ],
      "probe": {
        "commands": ["codex"],
        "configPaths": ["$HOME/.codex", "/etc/codex"]
      }
    },
    {
      "registryId": "copilot",
